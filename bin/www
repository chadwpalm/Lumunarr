#!/usr/bin/env node

var app = require("../app");
var http = require("http");
const { getActivePort, getBaseURL } = require("../backend/config");

// Port and base URL come from env vars or settings (see backend/config.js)
var port = getActivePort();
app.set("port", port);

var server = http.createServer(app);

// Listen on all network interfaces
server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

function onError(error) {
  if (error.syscall !== "listen") {
    throw error;
  }

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case "EACCES":
      console.error(`Port ${port} requires elevated privileges`);
      process.exit(1);
      break;
    case "EADDRINUSE":
      console.error(`Port ${port} is already in use`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  console.info(`[STARTUP] Lumunarr listening on port ${port} at "${getBaseURL() || "/"}"`);
}
